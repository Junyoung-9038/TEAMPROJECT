# 이 파일을 복사해 이름을 .env로 바꾼 뒤 실제 키를 입력하세요.
# .env는 절대로 GitHub에 올리지 마세요.

GEMINI_API_KEY=여기에_Gemini_API_키
GEMINI_MODEL=gemini-3.6-flash

# 공공데이터포털에서 발급받은 '일반 인증키(Decoding)'를 붙여 넣으세요.
MFDS_API_KEY=여기에_공공데이터포털_일반인증키_Decoding

PORT=3000

# 식약처가 API 버전을 바꾼 경우에만 아래 주석을 풀고 새 경로로 바꾸세요.
# MFDS_BASE_URL=https://apis.data.go.kr/1471000
# MFDS_PRODUCT_PATH=/DrugPrdtPrmsnInfoService06/getDrugPrdtPrmsnDtlInq06
# MFDS_DUR_PRODUCT_PATH=/DURPrdlstInfoService03/getDurPrdlstInfoList3
# MFDS_DUR_INTERACTION_PATH=/DURPrdlstInfoService03/getUsjntTabooInfoList03
# MFDS_DUR_DUPLICATE_PATH=/DURPrdlstInfoService03/getEfcyDplctInfoList03
# MFDS_DUR_ELDERLY_PATH=/DURPrdlstInfoService03/getOdsnAtentInfoList03
